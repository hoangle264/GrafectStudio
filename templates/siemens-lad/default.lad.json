{
  "version": "1.0",
  "platform": "siemens-lad",
  "tiaVersion": 17,
  "blockName": "{{unit.name}}_Grafcet_LAD",
  "blockNumber": 1,
  "parameters": [
    { "key": "prevDone", "source": "step.doneAddress", "default": "PrevDone", "scope": "global", "dataType": "Boolean" },
    { "key": "exec", "source": "step.execAddress", "default": "Exec", "scope": "global", "dataType": "Boolean" },
    { "key": "done", "source": "step.doneAddress", "default": "Done", "scope": "global", "dataType": "Boolean" },
    { "key": "condition", "source": "transition.condition", "default": "Condition", "scope": "global", "dataType": "Boolean" },
    { "key": "feedback", "source": "transition.condition", "default": "Feedback", "scope": "global", "dataType": "Boolean" },
    { "key": "actionAddr", "source": "action.address", "default": "Action", "scope": "global", "dataType": "Boolean" }
  ],
  "networks": [
    {
      "id": "step_activation",
      "repeat": "steps",
      "title": "Activate {{flow.name}} S{{step.number}} {{step.label}}",
      "comment": "prevDone & condition -> exec for step {{step.number}}",
      "expression": {
        "type": "AND",
        "nodes": [
          { "type": "TAG", "ref": "prevDone" },
          { "type": "TAG", "ref": "condition" }
        ]
      },
      "output": { "type": "coil", "ref": "exec" }
    },
    {
      "id": "step_done",
      "repeat": "steps",
      "title": "Done {{flow.name}} S{{step.number}} {{step.label}}",
      "comment": "exec & feedback -> done for step {{step.number}}",
      "expression": {
        "type": "AND",
        "nodes": [
          { "type": "TAG", "ref": "exec" },
          { "type": "TAG", "ref": "feedback" }
        ]
      },
      "output": { "type": "coil", "ref": "done" }
    },
    {
      "id": "action",
      "repeat": "actions",
      "title": "Action {{action.variable}} on S{{step.number}}",
      "comment": "exec -> action output {{action.variable}}",
      "expression": { "type": "TAG", "ref": "exec" },
      "output": { "type": "coil", "ref": "actionAddr" }
    }
  ]
}
